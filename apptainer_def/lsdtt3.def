Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer Simon M. Mudd
    Version 1.0
    Description lsdtt3 build and runtime environment

%post
    # -------------------------------------------------------------------------
    # Prevent interactive prompts during apt installs
    # -------------------------------------------------------------------------
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    apt-get update -y
    apt-get upgrade -y

    # -------------------------------------------------------------------------
    # Core build tools
    # -------------------------------------------------------------------------
    apt-get install -y \
        build-essential \
        cmake \
        ninja-build \
        git \
        pkg-config \
        wget \
        ca-certificates

    # -------------------------------------------------------------------------
    # GDAL - development headers and runtime binaries
    # -------------------------------------------------------------------------
    apt-get install -y \
        gdal-bin \
        libgdal-dev \
        python3-gdal

    # -------------------------------------------------------------------------
    # FFTW3 - double precision (fftw_* API)
    # Serial only - lsdtt3 does not use the threaded FFTW API
    # -------------------------------------------------------------------------
    apt-get install -y \
        libfftw3-dev \
        libfftw3-3

    # -------------------------------------------------------------------------
    # Eigen3 - header-only linear algebra library
    # -------------------------------------------------------------------------
    apt-get install -y \
        libeigen3-dev

    # -------------------------------------------------------------------------
    # NetCDF - C library, used for crn_parameters.nc (cosmogenic nuclide
    # atmospheric / palaeomagnetic correction data)
    # -------------------------------------------------------------------------
    apt-get install -y \
        libnetcdf-dev

    # -------------------------------------------------------------------------
    # OpenMP - provided by GCC, but make explicit
    # -------------------------------------------------------------------------
    apt-get install -y \
        libgomp1

    # -------------------------------------------------------------------------
    # Useful runtime utilities
    # -------------------------------------------------------------------------
    apt-get install -y \
        python3 \
        python3-pip \
        less \
        vim-tiny

    # -------------------------------------------------------------------------
    # Release tooling: what .github/workflows/release.yml installs beyond the
    # build dependencies, so tools/make_release.sh runs inside this container.
    #   python3-venv, python3-dev  the Python bindings smoke check builds the
    #                              bindings in a venv against Python headers
    #   patchelf                   package_linux_backend.sh sets the bundle rpath
    # -------------------------------------------------------------------------
    apt-get install -y \
        python3-venv \
        python3-dev \
        patchelf

    # -------------------------------------------------------------------------
    # Clean up apt cache to reduce image size
    # -------------------------------------------------------------------------
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    # Make GDAL headers and pkg-config visible to CMake
    export GDAL_DATA=/usr/share/gdal
    export PROJ_LIB=/usr/share/proj

    # Ensure pkg-config can find fftw3
    export PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH}

%runscript
    echo "lsdtt3 build environment"
    echo "  GCC:    $(gcc --version | head -1)"
    echo "  CMake:  $(cmake --version | head -1)"
    echo "  GDAL:   $(gdal-config --version)"
    echo ""
    echo "To build lsdtt3:"
    echo "  mkdir build && cd build"
    echo "  cmake .. -DCMAKE_BUILD_TYPE=Release"
    echo "  make -j\$(nproc)"

%test
    # Verify key dependencies are present and pkg-config can find them
    echo "--- Checking build tools ---"
    gcc --version
    g++ --version
    cmake --version

    echo "--- Checking GDAL ---"
    gdal-config --version
    gdal-config --cflags
    gdal-config --libs

    echo "--- Checking FFTW3 ---"
    pkg-config --modversion fftw3
    pkg-config --cflags fftw3
    pkg-config --libs fftw3

    echo "--- Checking Eigen3 ---"
    pkg-config --modversion eigen3

    echo "--- Checking NetCDF ---"
    pkg-config --modversion netcdf

    echo "--- Checking release tooling ---"
    python3 -m venv --help >/dev/null && echo "python3 venv: ok"
    python3-config --includes
    patchelf --version

    echo "--- All checks passed ---"
