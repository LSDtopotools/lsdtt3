read_path: __READ_PATH__
read_fname: tiny_dem.asc
write_path: __WRITE_PATH__
write_fname: tiny

raster_is_filled: false
threshold_contributing_pixels: 1

select_all_basins: true

write_basin_outlines: true
write_basin_outlines_as_polygon: false
basin_outlines_write_vector_format: flatgeobuf

write_basin_outlet_points: false
write_channel_network_lines: false
write_channel_network_points: false
write_channel_network_junctions: false
write_basins_raster: false
calculate_spatial_index: false
