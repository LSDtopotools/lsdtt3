# Smoke test for lsdtt-slope-area on the basin_stats fixture DEM (200 x 200,
# 30 m, UTM 58S): D-infinity drainage area (the default), direct-polyfit slope
# at lambda 90 m and 150 m (3 and 5 cells), 10 log bins. Outputs are identical
# for n_threads 1 and 4.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
polyfit_lambda_metres_list: 90,150
n_log_bins: 10
