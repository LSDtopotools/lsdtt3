read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: chivg

# fill_flat_resolution_choice in lsdtt-chi-analysis (C6). The valley (11 x 24,
# 10 m cells, one flat floor at 100, outlet 99 at row 5, col 0) is filled and
# its floor resolved by barnes2014b_gradient before routing; the diagnostics
# are those of the resolver on this fixture (unit_flat_resolution F6).

raster_is_filled: false
fill_min_slope: 0.0001
fill_flat_resolution_choice: barnes2014b_gradient
threshold_contributing_pixels: 1
min_channel_pixels: 1
n_largest_basins: 0

mn_min: 0.5
mn_max: 0.5
mn_step: 0.1

fit_chi_networks: true
write_fit_tables: true
run_inversion: false
