read_path: __READ_PATH__
read_fname: tiny_dem.asc
read_initial_dem: true
write_path: __WRITE_PATH__
write_fname: cellular
write_output_format: gtiff
enable_d8_fluvial_erosion: false
enable_dinf_fluvial_erosion: false
enable_hillslope_transport: true
enable_uplift: false
hillslope_model: cellular
hillslope_diffusivity: 0.01
critical_hillslope_slope: 0.8
cellular_r_match: 0.85
cellular_cfl_safety: 0.8
cellular_nonlocal_fraction: 0.5
cellular_nonlocal_activation_ratio: 0.7
cellular_nonlocal_deposition_probability: 0.5
cellular_nonlocal_max_hops: 4
enable_cellular_particles: true
cellular_particle_inverse_density: 2
cellular_particle_mixing_depth: 0.1
cellular_particle_seed: 17
boundary_conditions: oooo
timestep: 0.01
number_of_iterations: 2
