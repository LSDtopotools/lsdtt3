# Stage 1 of the two-step workflow on the dissected staircase:
# lsdtt-flat-surface-finder writes the flat mask that
# rigorous_fluvial_surfaces_flat_mask_input reads as flat_mask_fname.
#
# Relief only, no morphology and no plane analysis, so the mask depends on as
# few settings as possible. A 50 m radius (5 cells, an 11x11 window) matches the
# built-in relief admission in fluvial_surfaces_smoke.param.in, so the two
# admissions are read at the same scale.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: fsfst

n_threads: 1
write_output_format: gtiff

relief_window_radius_metres: 50
max_relief_metres: 2.0
relief_threshold_algorithm_choice: fixed
flat_closing_radius_metres: 0
flat_opening_radius_metres: 0
min_component_pixels: 50
run_plane_analysis: false

write_combined_flat_mask_raster: true
write_metric_flat_mask_rasters: false
write_texture_rasters: false
