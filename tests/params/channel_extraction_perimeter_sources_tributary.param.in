# Perimeter sources on the Carradale shape (trunk entering north, tributary
# entering west, one exit south): 2 sources, 1 outlet crossing.
read_path: __READ_PATH__
read_fname: ps_tributary_dem.tif
write_path: __WRITE_PATH__
write_fname: pst
n_threads: 1
run_perimeter_sources: true
perimeter_min_valley_width_metres: 200
write_channel_network_lines: false
write_channel_network_points: false
write_channel_network_junctions: false
calculate_spatial_index: false
