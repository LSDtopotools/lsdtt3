# lsdtt-slope-stability: probability of failure of the rupture planes from
# uniform cohesion and friction (5 x 5 equal-density combinations), dry.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: ssu
n_threads: 2
run_sinmap: false
write_landslide_label_rasters: false
parameter_uncertainty: equal_density
rupture_cohesion_pa_min: 500
rupture_cohesion_pa_max: 1500
rupture_friction_coefficient_min: 0.6
rupture_friction_coefficient_max: 0.8
uncertainty_samples_per_parameter: 5
