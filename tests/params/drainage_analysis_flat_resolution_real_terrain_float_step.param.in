read_path: __READ_PATH__
read_fname: flat_resolution_lakeland_crop_dem.tif
write_path: __WRITE_PATH__
write_fname: rtfs

# fill_flat_resolution_choice: barnes2014b_float_step on real terrain (Step 11d
# real-terrain gate). The input is the committed 128 x 128 Copernicus GLO-30
# crop of Canadian Shield lakeland (tests/README.md, "Fixtures and test data").
# A single Barnes pass (RichDEM ResolveFlats) leaves rim cells on this crop
# without a lower neighbour and the D8 router then refuses them with "could not
# assign a receiver"; this is the command shape that failed that way. With the
# round loop and the final priority-flood pass the surface routes.

raster_is_filled: false
fill_flat_resolution_choice: barnes2014b_float_step
fill_min_slope: 0.0001
write_output_format: gtiff

write_d8_drainage_area_raster: true
write_dinf_drainage_area_raster: false
write_mfd_drainage_area_raster: false
write_twi_raster: false
write_connectivity_raster: false
write_height_above_channel_raster: false
