# lsdtt-water-line-repair with the water and road layers in separate datasets
# (road_vector_fname). Both are single-file CSV datasets. Absolute paths via
# __READ_PATH__: a name containing a directory separator is NOT joined to
# read_path by lsdtt_param_parser::add_read_path_if_needed (noted 2026-10-14).
read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: wlr
input_vector_fname: __READ_PATH__/water_line_repair_fixture/water.csv
road_vector_fname: __READ_PATH__/water_line_repair_fixture/road.csv
water_layer: water
road_layer: road
