# lsdtt-water-line-repair with the water and road layers in separate datasets
# (road_vector_fname). Both are single-file CSV datasets named by RELATIVE paths
# with a directory in them; they must resolve against read_path. Until
# 2026-10-14 lsdtt_param_parser::add_read_path_if_needed used any name
# containing a separator as given (relative to the working directory), and
# this test only worked with absolute paths.
read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: wlr
input_vector_fname: water_line_repair_fixture/water.csv
road_vector_fname: water_line_repair_fixture/road.csv
water_layer: water
road_layer: road
