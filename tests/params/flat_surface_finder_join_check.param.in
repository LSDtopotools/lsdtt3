# Phase 1 relational check: the same dissected-staircase configuration as
# flat_surface_finder_band_then_label.param.in, but with every joinable table
# switched on at once. The band-then-label smoke test pins each file's schema
# in isolation; this one exists so the LABEL actually joins across them.
#
# write_hand_profile_csv is the reason this template is separate: it is off by
# default and the band-then-label smoke fixture does not enable it, so the
# HAND-profile join was the one emitted table nothing had ever checked.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: join

n_threads: 1
write_output_format: gtiff

relief_window_pixels: 5
relief_threshold_metres: 2.0
min_component_pixels: 50

find_floodplain: true
label_within_bands: true

ladder_break_algorithm_choice: jenks
ladder_level_count: 4
vertical_accuracy_metres: 0.5
resolvability_kappa: 3.0

channel_threshold_contributing_pixels: 500
floodplain_max_height_metres: 5.0
terrace_min_height_metres: 5.0

write_banded_labels_raster: true
write_band_index_raster: true
write_surface_class_raster: true
write_surface_patches_csv: true
write_ladder_windows_csv: true
write_hand_profile_csv: true
