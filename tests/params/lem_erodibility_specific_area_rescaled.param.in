# C14: specific-area K calibrated at 5 m is converted to the 10 m grid.
read_path: __READ_PATH__
read_fname: lemk_dem.tif
write_path: __WRITE_PATH__
write_fname: lemkspec
read_initial_dem: true
erodibility: 1e-4
snap_initial_surface_to_steady_state: false
boundary_conditions: oooo
n_threads: 1
number_of_iterations: 20
timestep: 100
frequency_of_output_writing: 10
write_output_format: gtiff
erodibility_fname: lemk_k_uniform.tif
erodibility_raster_m_exponent: 0.45
erodibility_raster_n_exponent: 1
erodibility_raster_area_convention: specific_area
erodibility_raster_calibration_cell_size_metres: 5
