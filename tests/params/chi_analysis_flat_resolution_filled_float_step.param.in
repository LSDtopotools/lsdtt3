read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: chivf

# raster_is_filled: true with a barnes2014b option (C7). The valley is already
# depression-filled with a true flat floor (a min_slope 0 fill leaves it
# unchanged), so routing it as it is fails ("could not assign a receiver",
# see failure_chi_analysis_flat_resolution_filled_inline). With
# barnes2014b_float_step the input is not filled again but its flat is
# resolved, so routing succeeds.

raster_is_filled: true
fill_flat_resolution_choice: barnes2014b_float_step
threshold_contributing_pixels: 1
min_channel_pixels: 1
n_largest_basins: 0

mn_min: 0.5
mn_max: 0.5
mn_step: 0.1

fit_chi_networks: true
write_fit_tables: true
run_inversion: false
