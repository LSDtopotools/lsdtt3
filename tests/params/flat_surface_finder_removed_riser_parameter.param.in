# The slope-break (riser) finder moved to lsdtt-feature-finder on 2026-10-26.
# A key that turned one of its outputs on is a hard error naming the new home;
# a key that only tuned it (vec_adaptive_C here) warns and continues, and is
# checked in smoke_flat_surface_finder_ignored_riser_parameter.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: remr

n_threads: 1
write_output_format: gtiff
relief_window_radius_metres: 20
max_relief_metres: 2.0
min_component_pixels: 50

write_slope_break_centreline_raster: true
