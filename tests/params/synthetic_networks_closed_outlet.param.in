read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: ocnclosed

n_rows: 32
n_cols: 32
cell_size: 100.0

domain_type: rectangle
outlet_mode: single

energy_exponent_gamma: 0.5
n_iter: 20000
temperature_scale: 0.0
random_seed: 7

steady_state_mode: relief
target_relief: 1000.0

# The OCN drains through a single south outlet, and 'nnnn' closes every edge.
# Without the CLI pre-check the router would throw from inside an OpenMP
# parallel region and the process would std::terminate rather than exit cleanly.
run_equilibration: true
boundary_conditions: nnnn

write_output_format: gtiff
