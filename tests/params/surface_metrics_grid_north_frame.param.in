# bearings_relative_to_true_north off (the default). The plane of
# surface_metrics_true_north_frame (true azimuth 200 deg, in the oblique frame
# of tests/data/rotation/lakeland_line_oblique.tif): aspect stays relative to
# grid north, 239.87 deg, and the start-up line says so.
read_path: __READ_PATH__/true_north
read_fname: plane_frame_true200.tif
write_path: __WRITE_PATH__
write_fname: gnframe
write_output_format: gtiff

polyfit_metrics: aspect_degrees
polyfit_lambda_metres: 90
bearings_relative_to_true_north: false
