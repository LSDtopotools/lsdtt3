read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: drainvf

# fill_flat_resolution_choice in lsdtt-drainage-analysis (C6, D8 family). The
# valley (11 x 24, 10 m cells, one flat floor at 100, outlet 99 at row 5,
# col 0) is filled and its floor resolved by barnes2014b_float_step before D8
# routing. The largest raise is 48 float32 steps of 2^-17 m.

raster_is_filled: false
fill_flat_resolution_choice: barnes2014b_float_step
write_output_format: gtiff
threshold_contributing_pixels: 1

write_d8_drainage_area_raster: true
write_dinf_drainage_area_raster: false
write_mfd_drainage_area_raster: false
write_twi_raster: false
write_connectivity_raster: false
write_height_above_channel_raster: false
