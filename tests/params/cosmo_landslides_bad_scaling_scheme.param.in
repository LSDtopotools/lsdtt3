read_path: __READ_PATH__
read_fname: tiny_dem.asc
write_path: __WRITE_PATH__
write_fname: lsbadscale

landslide_mode: single_event
threshold_contributing_pixels: 20
event_volume_m3: 20
event_time_yr: 0
random_seed: 7

# Guard test: scaling_scheme must be one of uniform/stone/lsdn when
# concentration output is requested.
calculate_crn_concentration: true
scaling_scheme: notARealScalingScheme
