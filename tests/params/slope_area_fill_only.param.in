# lsdtt-slope-area with the fill alone (breach_before_fill: false): the fill
# raises 7459 of the 40000 cells, which are excluded from the bins. The polyfit
# slope raster is fitted to the INPUT DEM, so it is byte-identical to that of
# the default (carve then fill) run, smoke_slope_area: both tests pin the same
# sha256.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
polyfit_lambda_metres_list: 90,150
n_log_bins: 10
breach_before_fill: false
