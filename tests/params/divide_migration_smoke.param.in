# End-to-end divide-migration run with NO clustering: one unit per outlet.
#
# The DEM is the synthetic three-valley strip written by
# lsdtt-test-divide-migration (unit_divide_migration, a CTest fixture): three
# parallel south-draining valleys, so units 1 and 3 are NOT adjacent and exactly
# two divides exist (1|2 and 2|3). The outlets sit on the trough of each valley
# at the southern edge, so no snapping is needed or wanted.
read_path: __READ_PATH__
read_fname: divmig_valleys.tif
write_path: __WRITE_PATH__
write_fname: divmig_nocluster

basin_outlet_file: divmig_outlets.fgb
basin_outlet_snapping_method: none

source_pixels_threshold: 40
m_over_n: 0.45
