# lsdtt-slope-area with write_flowinfo_rasters: false. The drainage area is
# still computed (the analysis needs it) but must not be written.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
polyfit_lambda_metres_list: 90,150
n_log_bins: 10
write_flowinfo_rasters: false
