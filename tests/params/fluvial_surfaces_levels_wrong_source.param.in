# Levels keyed to a channel that is not in this run's scope: the run must stop
# and name the channel that has no levels.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: xsw

n_threads: 1
write_output_format: gtiff

fluvial_surface_algorithm_choice: cross_section_levels
supplied_levels_fname: staircase_levels_wrong_source.csv
admission_algorithm_choice: relief
relief_window_radius_metres: 50
max_relief_metres: 2.0
threshold_contributing_pixels: 500
source_points_fname: staircase_sources.fgb
vertical_accuracy_metres: 0.5
write_band_index_raster: true
write_ladder_windows_csv: true
