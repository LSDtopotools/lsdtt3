# Rupture planes under a uniform pseudo-static load.
read_path: __READ_PATH__
read_fname: hazard_dem.tif
write_path: __WRITE_PATH__
write_fname: ssg
n_threads: 1
run_sinmap: false
threshold_contributing_pixels: 200
rupture_peak_ground_acceleration_fname: hazard_pga.tif
rupture_seismic_coefficient_ratio: 0.5
rupture_min_daylight_neighbours: 0
