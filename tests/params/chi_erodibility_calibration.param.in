# lsdtt-chi-analysis with erosion-rate samples on the F1 known answer
# (lsdtt-test-erodibility-calibration --write-fixtures): a steady state with
# K = 1e-5 everywhere, n = 1 (m = 0.45), and a different uplift U_b in each of
# ten basins, so E_b = U_b = K k_sn^n. Samples: the ten outlets, a nested one,
# a duplicate, one with twice its area, one off the grid.
read_path: __READ_PATH__
read_fname: f1_dem.tif
write_path: __WRITE_PATH__
write_fname: ercal

raster_is_filled: true
boundary_conditions: oooo
threshold_contributing_pixels: 50
min_channel_pixels: 30
n_largest_basins: 0
m_over_n: 0.45
chi_A0: 1

fit_chi_networks: true
write_fit_tables: true
write_ksn_basin_summary: true

erosion_rate_fname: f1_samples.csv
erosion_rate_units: mm_per_kyr
erosion_rate_snap_max_distance_metres: 0
stream_power_n_values: 1,2
