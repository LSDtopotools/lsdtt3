# lsdtt-slope-area must refuse a clip mask whose grid differs from the DEM's.
# tiny_dem.asc (5 x 5) is copied next to the DEM by fixture_basin_stats_tiny_dem.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
polyfit_lambda_metres_list: 90,150
n_log_bins: 10
basin_clip_mode: mask
basin_mask_fname: tiny_dem.asc
