read_path: __READ_PATH__
read_fname: tiny_dem.asc
write_path: __WRITE_PATH__
write_fname: lsens

landslide_mode: series
threshold_contributing_pixels: 20
series_start_yr: 0
series_end_yr: 5000
mean_recurrence_yr: 1000
poisson_timing: false
long_term_erosion_rate_mm_kyr: 20
random_seed: 7

run_sample_point_ensemble: true
sample_points_csv: cosmo_tiny_points.csv
n_realisations: 3

scaling_scheme: uniform
calculate_crn_concentration: true
nuclide: Be10
muon_scheme: BraucherBorchers
background_eff_erate_g_cm2_yr: 0.001
crn_report_time_yr: 5000

write_output_format: gtiff
