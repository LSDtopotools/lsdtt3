# bearings_relative_to_true_north. Patch aspect_degrees
# and terrain_aspect_degrees on the lakeland frame DEM.
read_path: __READ_PATH__/rotation
read_fname: lakeland_line_oblique.tif
write_path: __WRITE_PATH__
write_fname: tnfs
n_threads: 1
write_output_format: gtiff
admission_algorithm_choice: relief
relief_window_radius_metres: 90
max_relief_metres: 8.0
min_band_component_pixels: 10
reference_field_algorithm_choice: hand
ladder_break_algorithm_choice: jenks
ladder_level_count: 3
vertical_accuracy_metres: 0.5
threshold_contributing_pixels: 30
write_patch_terrain_aspect: true
bearings_relative_to_true_north: true
