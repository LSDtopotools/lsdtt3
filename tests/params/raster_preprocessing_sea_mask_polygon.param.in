# Sea mask from a sea polygon given in EPSG:4326 (reprojected to the DEM's
# EPSG:32630): auto picks sea_inside, the same 800 cells as the coastline.
read_path: __READ_PATH__
read_fname: sea_mask/coast_dem.tif
write_path: __WRITE_PATH__
write_fname: smpoly
enforce_projection: false
write_output_format: gtiff
min_elevation: -9999
write_fill_raster: true
write_hillshade_raster: false
write_sea_mask_raster: true
sea_mask_fname: sea_mask/sea_polygon_wgs84.fgb
