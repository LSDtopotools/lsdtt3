# lsdtt-channel-network-analysis failure case: a region code raster off the DEM grid with no CRS to warp it.
read_path: __READ_PATH__
write_path: __WRITE_PATH__
n_threads: 1
threshold_contributing_pixels: 8
write_vector_format: csv
read_fname: cbs_trellis_dem.tif
write_fname: cbsf
boundary_conditions: nnon
write_channel_bearing_statistics: true
channel_bearing_group_by: region
channel_region_fname: cbs_region_off_grid.tif
