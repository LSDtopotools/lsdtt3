read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: rlvg

# fill_flat_resolution_choice in lsdtt-ridgeline-analysis (C6), default
# basin_outline_ridgelines mode. The valley (11 x 24, 10 m cells, one flat
# floor at 100, outlet 99 at row 5, col 0) is filled and its floor resolved
# by barnes2014b_gradient before routing. At a 5-pixel threshold the
# resolved floor gives 55 junction basins (110 ridgeline segments); the
# default fill's parallel flow gives 18.

n_threads: 1
raster_is_filled: false
fill_min_slope: 0.0001
fill_flat_resolution_choice: barnes2014b_gradient
threshold_contributing_pixels: 5
select_all_basins: true
write_basin_outlines_to_csv: true
