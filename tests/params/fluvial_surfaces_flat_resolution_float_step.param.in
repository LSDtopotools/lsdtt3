read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: fsvf

# fill_flat_resolution_choice in lsdtt-fluvial-surfaces (C6). The valley
# (11 x 24, 10 m cells, one flat floor at 100, outlet 99 at row 5, col 0) is
# filled for routing and its floor resolved by barnes2014b_float_step. The
# resolved floor converges on the valley axis, so 3 channel sources are in
# scope at a 20-pixel threshold; the default fill's parallel flow gives 9.

n_threads: 1
write_output_format: gtiff
fill_before_routing: true
fill_flat_resolution_choice: barnes2014b_float_step
threshold_contributing_pixels: 20
fallback_admission_algorithm_choice: relief
fallback_relief_window_radius_pixels: 2
fallback_relief_threshold_metres: 2.0
min_component_pixels: 5
reference_field_algorithm_choice: hand
vertical_accuracy_metres: 0.5
write_hand_raster: true
