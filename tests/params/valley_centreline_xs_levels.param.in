# Cross-section levels workflow, stage 2 of 3: lsdtt-valley-centreline clusters
# every section's width-step breaks into levels per channel. Sections are
# forced to span the 1.2 km flight on each side; the same source points and
# threshold as stage 1 so the source ids match.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: xs2

n_threads: 1
write_output_format: gtiff

valley_mask_fname: __WRITE_PATH__/xs1_valley_mask.tif
source_points_fname: staircase_sources.fgb
threshold_contributing_pixels: 500
write_valley_cross_sections: true
cross_section_spacing_metres: 200
cross_section_min_half_length_metres: 1300
cross_section_max_half_length_metres: 1300
write_cross_section_features: true
write_cross_section_levels_csv: true
ladder_break_algorithm_choice: jenks
vertical_accuracy_metres: 0.5
