# Tuning keys of the slope-break (riser) finder, which moved to
# lsdtt-feature-finder on 2026-10-26: each warns, names its riser_* key there,
# and the run continues.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: ignr

n_threads: 1
write_output_format: gtiff
relief_window_radius_metres: 20
max_relief_metres: 2.0
min_component_pixels: 50
write_combined_flat_mask_raster: true

vec_adaptive_C: -2
slope_break_connect_search_radius_metres: 300
