read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: valleyfs

# Valley with one flat floor (11 x 24, 10 m cells, floor 100, walls 110,
# outlet 99 at row 5, col 0). barnes2014b_float_step raises the floor by
# up to 48 float32 steps of 2^-17 m (max mask 48), so the largest fill
# difference is 48 x 2^-17 = 3.662e-4 m. The default fill (inline_gradient)
# gives 0.0255 m here, so the band also shows the option is not falling back
# to the default.

enforce_projection: false
write_output_format: gtiff

write_fill_raster: true
write_fill_diff_raster: true
fill_flat_resolution_choice: barnes2014b_float_step
