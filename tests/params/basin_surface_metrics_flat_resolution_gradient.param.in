read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: bsmvg

# fill_flat_resolution_choice in lsdtt-basin-surface-metrics (C6). The valley
# (11 x 24, 10 m cells, one flat floor at 100, outlet 99 at row 5, col 0) is
# filled and its floor resolved by barnes2014b_gradient before routing. The
# outlet (flat_valley_outlets.csv, row 5, col 1) then drains the whole floor,
# so its basin is a different junction basin (junction 45) from the one the
# default fill's parallel flow gives (junction 58).

write_output_format: gtiff
raster_is_filled: false
fill_min_slope: 0.0001
fill_flat_resolution_choice: barnes2014b_gradient
threshold_contributing_pixels: 1

basin_outlet_fname: __READ_PATH__/flat_valley_outlets.csv
basin_outlet_snapping_method: none

lambda_scales: 20
polyfit_metrics: slope
polyfit_method: direct
write_outline_curvature_flips: true
write_basin_slope_area_stats: true
