# lsdtt-slope-stability: structurally controlled planes (bedding dipping 0.5
# towards the south-east), ordinary method, every crown evaluated.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: ssj
n_threads: 2
run_sinmap: false
slip_surface_family: structural
slip_surface_method: ordinary
slip_surface_structural_dip_gradient: 0.5
slip_surface_structural_dip_direction_degrees: 135
slip_surface_screen_safety_factor: 1e30
write_landslide_catalogue: false
write_landslide_label_rasters: false
