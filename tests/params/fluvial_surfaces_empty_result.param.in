# The empty-result regression, driven through lsdtt-fluvial-surfaces after
# phase 4.
#
# Ground IS admitted; min_component_pixels is simply larger than the raster, so
# no connected component survives the size filter and the patch table comes out
# empty. Reaching the empty case this way rather than by admitting nothing is
# deliberate: lsdtt-fluvial-surfaces treats a zero-admission run as a fatal user
# error and says so, which is the right behaviour and should not be weakened to
# make a test reachable. A run with real ground and no surviving patch is also
# the more realistic degenerate case.
#
# The point is the OUTPUT SHAPE of that case. A writer that suppresses a table
# with no rows is indistinguishable downstream from a writer that crashed, so
# the contract is that the header row is always written. The ladder table is
# allowed rows: the ladder ran perfectly well on real ground here, and the fact
# that nothing survived the SIZE filter afterwards is not a ladder failure.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: empty

n_threads: 1
write_output_format: gtiff

fallback_relief_window_radius_pixels: 5
fallback_relief_threshold_metres: 2.0
min_component_pixels: 100000


ladder_break_algorithm_choice: jenks
ladder_level_count: 4
vertical_accuracy_metres: 0.5

channel_threshold_contributing_pixels: 500
floodplain_max_height_metres: 5.0
terrace_min_height_metres: 5.0

write_banded_labels_raster: true
write_band_index_raster: true
write_surface_class_raster: true
write_surface_patches_csv: true
write_ladder_windows_csv: true
ladder_resolvability_kappa: 3.0
