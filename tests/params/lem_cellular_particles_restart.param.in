read_path: __READ_PATH__
read_fname: cellular_modelled_topography.tif
read_initial_dem: true
write_path: __WRITE_PATH__
write_fname: cellularrestart
write_output_format: gtiff
enable_d8_fluvial_erosion: false
enable_dinf_fluvial_erosion: false
enable_hillslope_transport: true
enable_uplift: false
hillslope_model: cellular
hillslope_diffusivity: 0.01
critical_hillslope_slope: 0.8
cellular_nonlocal_fraction: 0.5
cellular_nonlocal_activation_ratio: 0.7
cellular_nonlocal_max_hops: 4
enable_cellular_particles: true
cellular_particle_restart_fname: cellular_cellular_particles.csv
boundary_conditions: oooo
timestep: 0.01
number_of_iterations: 1
