# Every outlet carries the same cluster label, so all three collapse into ONE
# unit. There is then no unit pair to compare and no divide to extract, and the
# run must fail up front naming the outlet and unit counts rather than quietly
# producing an empty divide set.
read_path: __READ_PATH__
read_fname: divmig_valleys.tif
write_path: __WRITE_PATH__
write_fname: divmig_single_unit

basin_outlet_fname: divmig_outlets.csv
outlet_cluster_field: cluster_all
outlet_cluster_mode: auto
basin_outlet_snapping_method: none

threshold_contributing_pixels: 40
m_over_n: 0.45
