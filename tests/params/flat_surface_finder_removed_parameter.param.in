# Phase 4, group (a): a key whose whole purpose was to TURN AN ANALYSIS ON.
# Ignoring it would leave the user believing their surfaces were classified when
# they were not, so it must be a hard error naming where the analysis went.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: rem

n_threads: 1
write_output_format: gtiff
relief_window_side_pixels: 5
relief_threshold_metres: 2.0
min_component_pixels: 50

find_floodplain: true
