# C27 / D1c: a channel mask half a cell off the DEM grid is refused.
read_path: __READ_PATH__
read_fname: lemk_dem.tif
write_path: __WRITE_PATH__
write_fname: lemkmask
read_initial_dem: true
erodibility: 1e-4
snap_initial_surface_to_steady_state: false
boundary_conditions: oooo
n_threads: 1
number_of_iterations: 20
timestep: 100
frequency_of_output_writing: 10
write_output_format: gtiff
channel_mask_fname: lemk_mask_shifted.tif
