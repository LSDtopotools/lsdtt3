# Several methods in one run (plan 7b): ladder and clubb2017 on the linear-range
# surface, with the settings of fluvial_surfaces_clubb2017. Each method's
# outputs must equal its single-method run byte for byte (the clubb2017 class
# raster carries that test's pin), and the comparison outputs are written.
read_path: __READ_PATH__
read_fname: fluvsurf_dem.tif
write_path: __WRITE_PATH__
write_fname: ml

n_threads: 1
write_output_format: gtiff

fluvial_surface_algorithm_choice: ladder,clubb2017
threshold_contributing_pixels: 50
min_band_component_pixels: 20
write_surface_class_raster: true
write_surface_patches_csv: true
write_surface_class_polygons: true
write_vector_format: flatgeobuf
