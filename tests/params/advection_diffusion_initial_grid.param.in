# lsdtt-advection-diffusion starting a NEW run from a supplied grid: read_path
# and read_fname name smoke_advection_diffusion's iteration-10 output. (Not the
# final surface: smoke_advection_diffusion_resume rewrites that in the same
# directory and may run concurrently.)
read_path: __READ_PATH__
read_fname: ad_model_iteration_10.tif
write_path: __WRITE_PATH__
write_fname: ad
n_threads: 1

n_rows: 40
n_cols: 50
cell_size_metres: 2
noise_target_stddev_metres: 4
random_seed: 33
boundary_conditions: opop
baselevel_elevation: 0
fill_initial_surface: true

fluvial_incision_model: dinf
hillslope_model: adi
K: 0.00025
D: 0.025
uplift_rate: 0.001
m_exponent: 0.5
n_exponent: 1

timestep: 40
number_of_iterations: 20
frequency_of_output_writing: 10
progress_reporting_interval: 10

