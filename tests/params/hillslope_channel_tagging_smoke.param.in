# lsdtt-hillslope-channel-tagging: D8 ridge on the basin_stats fixture DEM.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: hct
threshold_contributing_pixels: 100
n_threads: 1
write_output_format: gtiff
write_hand_raster: true
write_channel_pixel_summary: true
