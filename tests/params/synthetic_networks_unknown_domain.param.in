read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: ocnbanana

n_rows: 16
n_cols: 16
cell_size: 100.0

domain_type: banana
outlet_mode: single

energy_exponent_gamma: 0.5
n_iter: 2000
temperature_scale: 0.0
random_seed: 1

write_dem_raster: true
write_drainage_area_raster: false
verify_routing: false
write_output_format: gtiff
