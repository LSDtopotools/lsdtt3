# Perimeter sources on the Salinas shape: the main valley enters south and
# leaves north; a second network starts inside and leaves east. 1 source.
read_path: __READ_PATH__
read_fname: ps_salinas_dem.tif
write_path: __WRITE_PATH__
write_fname: pss
n_threads: 1
run_perimeter_sources: true
perimeter_min_valley_width_metres: 200
write_channel_network_lines: false
write_channel_network_points: false
write_channel_network_junctions: false
calculate_spatial_index: false
