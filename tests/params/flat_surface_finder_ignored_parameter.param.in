# Phase 4, group (b) and the alias window: keys that must WARN AND CONTINUE.
#
# The contrast with flat_surface_finder_removed_parameter.param.in is the point.
# Nothing here can be mistaken for a missing analysis:
#   enable_hand_banding      tuned a mechanism the ladder replaced outright
#   terrace_min_height_metres  moved to lsdtt-fluvial-surfaces along with the
#                              switch that made it matter
#   write_combined_flat_mask   still exists, just under a new name, so its value
#                              is carried across rather than dropped
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: ign

n_threads: 1
write_output_format: gtiff
relief_window_radius_metres: 20
max_relief_metres: 2.0
min_component_pixels: 50

enable_hand_banding: false
terrace_min_height_metres: 5.0
write_combined_flat_mask: true
