# Phase 1 empty-result regression: the same pipeline as
# flat_surface_finder_join_check.param.in, but with a relief threshold no pixel
# on the staircase can meet, so nothing is admitted and the classifier has no
# patch to report.
#
# The point is the OUTPUT SHAPE of that case, not the case itself. A writer
# that suppresses a table with no rows is indistinguishable downstream from a
# writer that crashed, so the contract is that the header row is always
# written. The ladder table is allowed rows here: a run with nothing admitted
# still owes a verdict, and one degenerate window is the honest one.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: empty

n_threads: 1
write_output_format: gtiff

# 0.1 mm of relief over a 5-pixel window: nothing qualifies as flat.
relief_window_pixels: 5
relief_threshold_metres: 0.0001
adaptive_relief_threshold: false
min_component_pixels: 50

find_floodplain: true
label_within_bands: true

ladder_break_algorithm_choice: jenks
ladder_level_count: 4
vertical_accuracy_metres: 0.5
resolvability_kappa: 3.0

channel_threshold_contributing_pixels: 500
floodplain_max_height_metres: 5.0
terrace_min_height_metres: 5.0

write_banded_labels_raster: true
write_band_index_raster: true
write_surface_class_raster: true
write_surface_patches_csv: true
write_ladder_windows_csv: true
