# reference_field_algorithm_choice relative_elevation: the smoke run's ladder
# on the staircase, but banding the relative elevation - height above a valley
# centreline traced through the valley floor (staircase_floor_mask.tif: the
# channel and the lowest tread) - instead of HAND. The staircase's treads are
# level across the valley, so the relative elevation finds the same treads.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: fsrer

n_threads: 1
write_output_format: gtiff

admission_algorithm_choice: relief
relief_window_radius_metres: 50
max_relief_metres: 2.0
min_band_component_pixels: 50

reference_field_algorithm_choice: relative_elevation
relative_elevation_floor_mask_fname: staircase_floor_mask.tif
ladder_break_algorithm_choice: jenks
ladder_level_count: 4
vertical_accuracy_metres: 0.5
ladder_resolvability_kappa: 3.0

threshold_contributing_pixels: 500
max_floodplain_hand_metres: 5.0
min_terrace_hand_metres: 5.0

write_reference_field_raster: true
write_band_index_raster: true
