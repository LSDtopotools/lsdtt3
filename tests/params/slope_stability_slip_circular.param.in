# lsdtt-slope-stability: circular slip surfaces (Bishop), seeded from the
# rupture planes, with the probability of failure on each critical surface.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: ssc
n_threads: 2
run_sinmap: false
slip_surface_family: circular
parameter_uncertainty: equal_density
uncertainty_samples_per_parameter: 3
