# Smoke test for lsdtt-stream-burning, and the guard for the C4 extraction.
#
# Runs in snap_to_network mode DELIBERATELY. The inward-draining edge carve --
# the ~160 lines C4 moves out of main() -- only runs in that mode, and only when
# the vector network has sources sitting on the raster boundary. In burn_in_place
# mode the carve stage is never reached at all.
#
# tests/data/stream_burning_network.fgb is built for exactly this: four of its
# five lines START ON A RASTER EDGE and run inward, so the carve has something
# to do. Without them the stage prints "Edge sources carved inward: 0" and the
# code being extracted never executes.
read_path: __READ_PATH__
read_fname: sb_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: burn

stream_vector_path: __READ_PATH__/stream_burning_network.fgb
stream_burn_mode: snap_to_network
do_stream_burn: true

carve_inward_edge_sources: true

write_burned_outputs: true
write_merged_lines: true
