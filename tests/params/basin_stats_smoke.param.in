# Smoke test AND refactor tripwire for lsdtt-basin-stats.
#
# Every output switch is on, so the per-basin accumulation loop, the record, the
# CSV writer and the polygon writer are all exercised. The outlet set covers
# both branches of the nodata/raster-edge test (reject_nodata_edge_basins is
# false so the edge basins are kept and reported rather than dropped).
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: bs

write_output_format: gtiff

basin_outlet_csv: deprecated_value_must_be_ignored.csv
basin_outlet_fname: __READ_PATH__/basin_stats_outlets.csv
basin_outlet_snapping_method: downstream
basin_outlet_contributing_pixels_threshold: 100
reject_nodata_edge_basins: false

calculate_channel_stats: true
# Deliberately omit threshold_contributing_pixels. This fixture pins the
# canonical shared default and CTest asserts its reported value and behaviour.
calculate_junction_area_ratios: true
calculate_centre_of_mass_bearing: true
calculate_shape_metrics: true
write_basin_polygons: true

# The table as CSV (the default is a FlatGeobuf point layer); the sha256
# oracle in tests/CMakeLists.txt pins this file.
basin_stats_write_vector_format: csv
