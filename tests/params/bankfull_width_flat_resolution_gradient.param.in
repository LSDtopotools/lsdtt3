read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: bfvg

# lsdtt-bankfull-width's low-slope WARNING, one test per
# fill_flat_resolution_choice branch. The valley (11 x 24, 10 m cells, one
# flat floor at 100, outlet 99 at row 5, col 0) has a floor slope of order
# 1e-4 or less after any choice, so most channel-profile sections fall below
# 10 x fill_min_slope (0.001) and the WARNING fires (19 of the 23 sections).
# The source (flat_valley_source.csv) is the head of the valley axis, row 5,
# col 22.
#
# The barnes2014b_gradient branch: the resolver gives the floor at least
# fill_min_slope (0.000141907 m/m here, unit_flat_resolution F6), and the
# WARNING names the flat resolution rather than the fill.

n_threads: 1
raster_is_filled: false
fill_min_slope: 0.0001
fill_flat_resolution_choice: barnes2014b_gradient
source_points_path: __READ_PATH__/flat_valley_source.csv
cross_section_half_length_metres: 40
cross_section_sample_spacing_metres: 2
bearing_window_length_metres: 30
cross_section_thinning: 1
thalweg_search_half_width_metres: 10
slope_window_half_length_metres: 30
calculate_spatial_index: false
