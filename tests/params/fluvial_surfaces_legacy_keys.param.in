# fluvial_surfaces_smoke.param.in under the names used before 2026-10-26.
# Every pinned output must be identical to rigorous_fluvial_surfaces_checksums.
# vertical_accuracy_break_degrees has no effect under the fixed mode; it is
# here to pin the tan() conversion and its record in the ingested file.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: fsurf

n_threads: 1
write_output_format: gtiff

fallback_admission_algorithm_choice: relief
fallback_relief_window_radius_pixels: 5
fallback_relief_threshold_metres: 2.0
min_component_pixels: 50

reference_field_algorithm_choice: hand
ladder_break_algorithm_choice: jenks
ladder_level_count: 4
vertical_accuracy_metres: 0.5
ladder_resolvability_kappa: 3.0
vertical_accuracy_mode: fixed
vertical_accuracy_break_degrees: 11.31

threshold_contributing_pixels: 500
floodplain_max_height_metres: 5.0
terrace_min_height_metres: 5.0

write_hand_raster: true
