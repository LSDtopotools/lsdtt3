read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: cnavf

# fill_flat_resolution_choice in lsdtt-channel-network-analysis (C6). The
# valley (11 x 24, 10 m cells, one flat floor at 100, outlet 99 at row 5,
# col 0) is filled and its floor resolved by barnes2014b_float_step before
# routing. The threshold-1 network then has 105 junctions and 80 Strahler
# channels; the default fill gives 116 and 71.

n_threads: 1
raster_is_filled: false
fill_flat_resolution_choice: barnes2014b_float_step
threshold_contributing_pixels: 1
calculate_spatial_index: false
write_area_scaling_summary: false
write_tokunaga_summary_data: true
