# lsdtt-feature-finder feature_type find_risers on the dissected staircase
# (fluvial-surfaces CLI fixture: 4 treads, 8 m risers, 3 graded gaps).
# astar gap closing; every output on, so the vector layers are checked too.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: ffr

n_threads: 1
write_output_format: gtiff
write_vector_format: flatgeobuf

feature_type: find_risers
riser_gap_closing_algorithm_choice: astar
riser_connect_search_radius_metres: 200
riser_min_step_height_metres: 1.0

write_riser_centreline_raster: true
write_riser_segments: true
write_riser_endpoints: true
write_riser_diagnostic_rasters: true
