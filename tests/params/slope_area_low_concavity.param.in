# The low-concavity finder (run_low_concavity_detection) on the basin_stats
# fixture: channels from 100 contributing pixels, the default fit (10-pixel
# downstream window, |theta| < 0.15, 150 m gradient window), default routing
# surface (carve then fill, carved and filled pixels excluded), D-infinity
# area, polyfit gradient for the bins (the finder always uses the D8 path).
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
polyfit_lambda_metres_list: 90
n_log_bins: 10
run_low_concavity_detection: true
threshold_contributing_pixels: 100
write_low_concavity_point_table: true
