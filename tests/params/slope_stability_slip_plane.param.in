# lsdtt-slope-stability: scaLr's plane integrated over the body (ordinary
# method), every crown evaluated, no catalogue.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: ssi
n_threads: 2
run_sinmap: false
slip_surface_family: plane_integrated
slip_surface_screen_safety_factor: 1e30
write_slip_body_catalogue: false
write_landslide_catalogue: false
write_landslide_label_rasters: false
