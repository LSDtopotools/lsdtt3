# lsdtt-bearing-comparison, analytic case: the 20-degree rotation with rotation_invariant: the distance is 0 and the
# optimal rotation is 340 degrees (i.e. -20).
# Inputs are text CSVs in tests/data/bearing_comparison/.
read_path: __READ_PATH__/bearing_comparison
write_path: __WRITE_PATH__
write_fname: bc
bearing_fname_1: sample.csv
bearing_fname_2: sample_rotated_20.csv
rotation_invariant: true
