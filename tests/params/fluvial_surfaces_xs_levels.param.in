# Cross-section levels workflow, stage 3 of 3: lsdtt-fluvial-surfaces bands the
# staircase on the levels stage 2 found (fluvial_surface_algorithm_choice
# cross_section_levels), with the same admission and scope as stage 1.
read_path: __READ_PATH__
read_fname: staircase_dem.tif
write_path: __WRITE_PATH__
write_fname: xs3

n_threads: 1
write_output_format: gtiff

fluvial_surface_algorithm_choice: cross_section_levels
supplied_levels_fname: __WRITE_PATH__/xs2_cross_section_levels.csv
admission_algorithm_choice: relief
relief_window_radius_metres: 50
max_relief_metres: 2.0
threshold_contributing_pixels: 500
source_points_fname: staircase_sources.fgb
vertical_accuracy_metres: 0.5
write_band_index_raster: true
write_ladder_windows_csv: true
