# lsdtt-outlet-matching with a 1 m search radius, so outlet 27 (whose own cell
# drains area from the DEM edge) has no other candidate. It must be reported
# as no_match, with the reason printed, while the other 28 still match.
read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: om
reference_dem_fname: basin_stats_diamond_square.tif
reference_outlet_fname: basin_stats_outlets.csv
target_dem_fname: basin_stats_diamond_square.tif
local_search_radius_metres: 1
n_threads: 1
