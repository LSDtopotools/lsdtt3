# lsdtt-slope-stability: 3-D ellipsoids by the method of columns, truncated at
# a layer (4 m deep in the west, 8 m in the east), with the probability of
# failure; the half-axis limit is lowered so the short fixture paths qualify.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sse3
n_threads: 2
run_sinmap: false
slip_surface_family: ellipsoid
slip_surface_ellipsoid_min_half_axis_pixels: 1.5
slip_surface_layer_depth_fnames: slope_stability_layer_depth.tif
slip_surface_search_points: 6
parameter_uncertainty: equal_density
uncertainty_samples_per_parameter: 3
