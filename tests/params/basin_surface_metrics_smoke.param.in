# Full-output run for lsdtt-basin-surface-metrics, and the guard for C12.
#
# C12 is the ~160 lines of outline curvature sign-flip counting and slope-area
# analysis that currently sit inline in main(). The helper audit calls them
# "the tool's actual science". Both are exercised here, over TWO lambda scales,
# so the per-lambda column expansion is covered as well as the metrics.
#
# The outlets are the 25 INTERIOR points of the basin-stats set. The four
# edge-adjacent ones are deliberately excluded: this CLI aborts on them with an
# uncaught std::runtime_error from junction_upstream_of_flat ("flat index is not
# on the channel network"). See the plan -- outlet snapping guarantees a
# contributing-pixel count, not membership of the junction network, and one bad
# outlet takes down the whole run.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: bsm

write_output_format: gtiff

basin_outlet_csv: __READ_PATH__/basin_surface_metrics_outlets.csv
basin_outlet_snapping_method: downstream
basin_outlet_contributing_pixels_threshold: 150
source_pixels_threshold: 150

lambda_scales: 60,120
polyfit_metrics: slope,maximum_curvature
polyfit_method: direct

write_outline_curvature_flips: true
write_basin_slope_area_csv: true
write_basin_slope_area_stats: true
write_outline_polygons_with_flipstats: true
write_basin_outlines_csv: true
