# Canonical threshold coverage for the height-above-channel consumer.
read_path: __READ_PATH__
read_fname: tiny_dem.asc
write_path: __WRITE_PATH__
write_fname: drainage_canonical

raster_is_filled: false
write_output_format: gtiff
threshold_contributing_pixels: 3

write_d8_drainage_area_raster: false
write_dinf_drainage_area_raster: false
write_mfd_drainage_area_raster: false
write_twi_raster: false
write_connectivity_raster: false
write_height_above_channel_raster: true
