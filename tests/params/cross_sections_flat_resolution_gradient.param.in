read_path: __READ_PATH__
read_fname: flat_valley_dem.asc
write_path: __WRITE_PATH__
write_fname: xsvg

# fill_flat_resolution_choice in lsdtt-cross-sections (C6). The valley
# (11 x 24, 10 m cells, one flat floor at 100, outlet 99 at row 5, col 0) is
# filled and its floor resolved by barnes2014b_gradient before routing. The
# source (flat_valley_source.csv) is the head of the valley axis, row 5,
# col 22; its D8 path runs straight down row 5 to the outlet under every
# choice, so the sections themselves are the default run's (23 centres).

n_threads: 1
write_output_format: gtiff
raster_is_filled: false
fill_min_slope: 0.0001
fill_flat_resolution_choice: barnes2014b_gradient
source_points_fname: __READ_PATH__/flat_valley_source.csv
cross_section_half_length_metres: 40
cross_section_sample_spacing_metres: 2
bearing_window_length_metres: 30
cross_section_thinning: 1
calculate_spatial_index: false
