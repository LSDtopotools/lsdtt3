# C29 / Q3: mode 2 with an irregular footprint; the domain is the footprint.
read_path: __READ_PATH__
write_path: __WRITE_PATH__
write_fname: lemkfoot
erodibility: 1e-4
snap_initial_surface_to_steady_state: false
boundary_conditions: oooo
n_threads: 1
number_of_iterations: 20
timestep: 100
write_output_format: gtiff
noise_type: white_noise
max_initial_elevation: 1
model_grid_source: erodibility_raster
erodibility_fname: lemk_k_src_footprint.tif
write_erodibility_raster: true
