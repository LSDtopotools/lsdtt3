# lsdtt-slope-area with slope_algorithm_choice: d8_flow_path: the centred D8
# flow-path gradient over windows of 150 and 300 m (5 and 10 cells on the 30 m
# fixture), on the default routing surface (carve then fill), D-infinity area.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sa
n_threads: 1
n_log_bins: 10
slope_algorithm_choice: d8_flow_path
d8_gradient_window_metres_list: 150,300
