# lsdtt-slope-stability with a transient water table: steady antecedent state,
# then a 12-hour storm and 36 hours of drainage.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: sst
n_threads: 2
run_sinmap: false
water_table_method: dupuit_transient
groundwater_hydraulic_conductivity_m_per_s: 1e-5
groundwater_recharge_m_per_s: 1e-8
groundwater_recharge_series_fname: slope_stability_recharge_series.csv
groundwater_output_times_s: 3600,21600,43200,172800
regolith_thickness_metres: 2
