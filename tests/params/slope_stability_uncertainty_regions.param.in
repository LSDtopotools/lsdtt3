# lsdtt-slope-stability: probability of failure with truncated-normal cohesion
# and friction about each region's central values (the region table sets
# rupture_cohesion_pa per region), 3 x 3 combinations.
read_path: __READ_PATH__
read_fname: basin_stats_diamond_square.tif
write_path: __WRITE_PATH__
write_fname: ssur
n_threads: 2
run_sinmap: false
write_landslide_catalogue: false
write_landslide_label_rasters: false
slope_stability_region_fname: slope_stability_regions.tif
slope_stability_region_table_fname: slope_stability_region_table.csv
parameter_uncertainty: equal_density
rupture_cohesion_distribution: normal
rupture_cohesion_pa_sd: 300
rupture_friction_coefficient_distribution: normal
rupture_friction_coefficient_sd: 0.05
uncertainty_samples_per_parameter: 3
