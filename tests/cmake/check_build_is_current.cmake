#
# Fail if any built executable is older than a source it was built from.
#
#   cmake -DMANIFEST=<build>/tests/build_currency_manifest.tsv -P check_build_is_current.cmake
#
# WHY THIS EXISTS
#
# A build system will happily run yesterday's binary, so "the test passed" and
# "the code passed" are different statements unless the binary is known to be
# current. A stale binary does not error -- it produces a confident green, which
# is the worst available failure mode for a test suite.
#
# Both halves of that bit this project on 2026-09-10:
#
#   * the parameter-convention baseline was generated against a tree in which
#     ten CLI binaries were older than their source and one had never been
#     built. It recorded two violations the source had already fixed and missed
#     nine that were really there;
#
#   * a CLI smoke test passed against an executable built before a function
#     signature changed, while a full build was at that moment FAILING on two
#     call sites in that same file.
#
# run_cli_smoke.py checks its own executable, which covers the CLI smoke tests.
# This covers everything else -- in particular the ~60 C++ test drivers, where a
# stale driver silently runs old object code and reports success.
#
# WHY CMAKE AND NOT PYTHON
#
# This was check_build_is_current.py until 2026-09-18. It moved to CMake script
# so that it runs in a build with no Python at all (the hermetic tier): a
# native-only build is exactly where nothing else would notice a stale driver.
#
# The manifest is generated by CMake at generate time from its own list of
# executable targets (one line per target: name, binary path, sources joined by
# '|'), so a target added later is covered without anyone having to remember
# this file exists.
#
# A target that has not been built at all is reported separately: that is a
# normal state during a partial build, but it means the target is UNCHECKED, so
# it is named rather than passed over in silence. It is not fatal on its own;
# only a stale binary is.
#
# Exit status: 0 current; non-zero (FATAL_ERROR) when a binary is stale or the
# manifest is missing or malformed. (cmake_language(EXIT) would allow distinct
# codes but needs CMake 3.29.)

cmake_minimum_required(VERSION 3.15)

if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "manifest not found: ${MANIFEST}")
endif()

file(STRINGS "${MANIFEST}" _lines)

set(_checked 0)
set(_missing "")
set(_stale_report "")
set(_n_stale 0)

foreach(_line IN LISTS _lines)
    if(_line STREQUAL "")
        continue()
    endif()
    string(REPLACE "\t" ";" _parts "${_line}")
    list(LENGTH _parts _n)
    if(NOT _n EQUAL 3)
        message(FATAL_ERROR "malformed manifest line: ${_line}")
    endif()
    list(GET _parts 0 _target)
    list(GET _parts 1 _exe)
    list(GET _parts 2 _joined)

    if(NOT EXISTS "${_exe}")
        list(APPEND _missing "${_target}")
        continue()
    endif()
    math(EXPR _checked "${_checked} + 1")

    string(REPLACE "|" ";" _sources "${_joined}")
    foreach(_src IN LISTS _sources)
        # A generated source that no longer exists is not this check's
        # business; the build would have failed already.
        if(_src STREQUAL "" OR NOT EXISTS "${_src}")
            continue()
        endif()
        # IS_NEWER_THAN is also true for EQUAL times, so "strictly newer" is
        # "src is newer than exe, and exe is not newer than src". It compares
        # at the filesystem's full timestamp resolution.
        if("${_src}" IS_NEWER_THAN "${_exe}" AND NOT "${_exe}" IS_NEWER_THAN "${_src}")
            file(TIMESTAMP "${_src}" _t_src "%s" UTC)
            file(TIMESTAMP "${_exe}" _t_exe "%s" UTC)
            math(EXPR _behind "${_t_src} - ${_t_exe}")
            string(APPEND _stale_report
                "    ${_target}\n"
                "        binary    : ${_exe}\n"
                "        older than: ${_src}\n"
                "        by        : ${_behind} s\n")
            math(EXPR _n_stale "${_n_stale} + 1")
            break()
        endif()
    endforeach()
endforeach()

list(LENGTH _missing _n_missing)
message("build currency: ${_checked} executable(s) checked, "
        "${_n_missing} not built, ${_n_stale} STALE")

if(_n_missing GREATER 0)
    list(SORT _missing)
    list(JOIN _missing "\n    " _missing_text)
    message("\nNOT BUILT (${_n_missing}) -- these targets are UNCHECKED by any "
            "test that runs them:\n    ${_missing_text}")
endif()

if(_n_stale GREATER 0)
    message(FATAL_ERROR
            "\nSTALE (${_n_stale}) -- the binary is older than its source, so "
            "any test running it reports on code that is no longer in the tree:\n"
            "${_stale_report}"
            "\nRebuild before trusting any result:  cmake --build <build dir>")
endif()
