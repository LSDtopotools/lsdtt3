# run_tests.cmake -- generated from tests/cmake/run_tests.cmake.in; do not edit.
#
# Part of lsdtt3 -- https://github.com/LSDtopotools/lsdtt3
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Runs ctest on this build tree with whatever arguments follow, keeping a
# complete, durable log:
#
#   cmake -P @CMAKE_BINARY_DIR@/run_tests.cmake -j4 -LE '^heavy$'
#
# WHY NOT PLAIN ctest
#
#   * CTest writes its per-test log to Testing/Temporary/LastTest.log.tmp and
#     renames it only when the run completes; the next ctest invocation of any
#     kind overwrites it, and `ctest --output-log` writes nothing on interrupt.
#     This wrapper streams the console output through `tee` into
#     test-logs/ctest_<timestamp>.log as it runs, so a killed or hung run still
#     leaves a record of every test that finished.
#   * CTest does not log its own arguments. They are recorded in
#     test-logs/last_run.txt, which the test_report target reads.
#   * On failure it prints the one command that builds a report to send:
#     cmake --build @CMAKE_BINARY_DIR@ --target test_report
#
# Plain ctest keeps working; the report then says the arguments were not
# recorded.

cmake_minimum_required(VERSION 3.15)

set(_build_dir "@CMAKE_BINARY_DIR@")
set(_ctest "@CMAKE_CTEST_COMMAND@")
set(_log_dir "${_build_dir}/test-logs")
file(MAKE_DIRECTORY "${_log_dir}")

# Everything after `-P <this script>` is for ctest.
set(_args "")
set(_script_seen FALSE)
set(_take FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
    if(_take)
        list(APPEND _args "${CMAKE_ARGV${_i}}")
    elseif(_script_seen)
        set(_take TRUE)
        list(APPEND _args "${CMAKE_ARGV${_i}}")
    elseif("${CMAKE_ARGV${_i}}" STREQUAL "-P")
        set(_script_seen TRUE)
    endif()
endforeach()
# The first element taken after -P is the script path itself; drop it.
list(LENGTH _args _n)
if(_n GREATER 0)
    list(REMOVE_AT _args 0)
endif()

string(TIMESTAMP _stamp "%Y%m%d_%H%M%S")
string(TIMESTAMP _start "%Y-%m-%d %H:%M:%S")
set(_log "${_log_dir}/ctest_${_stamp}.log")
list(JOIN _args " " _args_text)

file(WRITE "${_log_dir}/last_run.txt"
     "args: ${_args_text}\n"
     "start: ${_start}\n"
     "console_log: ${_log}\n")

message("lsdtt3: ctest ${_args_text}")
message("lsdtt3: logging to ${_log}")

if(UNIX)
    execute_process(
        COMMAND "${_ctest}" ${_args}
        COMMAND tee "${_log}"
        WORKING_DIRECTORY "${_build_dir}"
        RESULTS_VARIABLE _results)
    list(GET _results 0 _rc)
else()
    # No tee: echo as it runs and write the log at the end (so an interrupted
    # run leaves only CTest's own LastTest.log.tmp).
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.18)
        execute_process(
            COMMAND "${_ctest}" ${_args}
            WORKING_DIRECTORY "${_build_dir}"
            OUTPUT_VARIABLE _out ERROR_VARIABLE _out
            ECHO_OUTPUT_VARIABLE ECHO_ERROR_VARIABLE
            RESULT_VARIABLE _rc)
    else()
        execute_process(
            COMMAND "${_ctest}" ${_args}
            WORKING_DIRECTORY "${_build_dir}"
            OUTPUT_VARIABLE _out ERROR_VARIABLE _out
            RESULT_VARIABLE _rc)
        message("${_out}")
    endif()
    file(WRITE "${_log}" "${_out}")
endif()

string(TIMESTAMP _end "%Y-%m-%d %H:%M:%S")
file(APPEND "${_log_dir}/last_run.txt"
     "end: ${_end}\n"
     "ctest_exit: ${_rc}\n")

if(NOT _rc EQUAL 0)
    message("")
    message("lsdtt3: some tests did not pass (ctest exit ${_rc}).")
    message("lsdtt3: to build a report you can send, run:")
    message("    cmake --build ${_build_dir} --target test_report")
    message(FATAL_ERROR "ctest failed")
endif()
