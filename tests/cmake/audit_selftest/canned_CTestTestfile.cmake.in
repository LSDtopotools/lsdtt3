# Hand-written stand-in for a generated CTestTestfile.cmake; see README.md.
# SELFTEST_DIR is set by the audit script before this file is included.

# ---- must pass -------------------------------------------------------------
add_test(sel_ok_native "/build/lsdtt-test-something")
set_tests_properties(sel_ok_native PROPERTIES ENVIRONMENT "LSDTT_NONINTERACTIVE=1" LABELS "unit;tier_native;hermetic" TIMEOUT "300")

# A Python fixture producer, and a native command that consumes its fixture and
# therefore legitimately carries its tier (propagation).
add_test(sel_ok_python_setup "/usr/bin/python3" "${SELFTEST_DIR}/scripts/plain_script.py")
set_tests_properties(sel_ok_python_setup PROPERTIES ENVIRONMENT "LSDTT_NONINTERACTIVE=1" LABELS "unit;tier_python_stdlib" TIMEOUT "300" FIXTURES_SETUP "fx_py")
add_test(sel_ok_inherit "/usr/bin/cmake" "-E" "compare_files" "a" "b")
set_tests_properties(sel_ok_inherit PROPERTIES ENVIRONMENT "LSDTT_NONINTERACTIVE=1" LABELS "rigorous;tier_python_stdlib" TIMEOUT "300" FIXTURES_REQUIRED "fx_py")

# A geo test whose third-party import arrives through a local module.
add_test(sel_ok_geo "/usr/bin/python3.10" "${SELFTEST_DIR}/scripts/geo_script.py")
set_tests_properties(sel_ok_geo PROPERTIES ENVIRONMENT "LSDTT_NONINTERACTIVE=1" LABELS "rigorous;tier_python_geo" TIMEOUT "300")

# Benchmarks own their time budgets, so no TIMEOUT is not a violation.
add_test(benchmark_sel_ok "/usr/bin/pixi" "run" "python" "x.py")
set_tests_properties(benchmark_sel_ok PROPERTIES ENVIRONMENT "LSDTT_NONINTERACTIVE=1" LABELS "benchmark;tier_pixi")

