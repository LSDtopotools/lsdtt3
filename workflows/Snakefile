import os

configfile: "config/config.yaml"

# The workflows environment ships its own GDAL and PROJ and exports their data
# paths. A CLI that inherits them loads the wrong GDAL plugins and PROJ
# database, so every shell command starts without them. An installed lsdtt3
# package needs its own paths back: lsdtt_setenv_script names its setenv.sh,
# which is sourced after the unset (and puts the CLIs on PATH).
_setenv = config.get("lsdtt_setenv_script") or ""
shell.prefix(
    "set -euo pipefail; unset GDAL_DATA GDAL_DRIVER_PATH PROJ_DATA PROJ_LIB PROJ_NETWORK; "
    + (f"set +u; source {os.path.abspath(os.path.expanduser(_setenv))}; set -u; " if _setenv else ""))

include: "rules/common_params.smk"
include: "rules/common_fetch.smk"
include: "rules/common_preprocess.smk"
include: "rules/common_extract.smk"
include: "rules/domain_cosmo.smk"
include: "rules/domain_cosmo_step_change.smk"
include: "rules/domain_cosmo_landslides_synthetic.smk"
include: "rules/domain_cosmo_transient_landslides.smk"
include: "rules/domain_check_basins.smk"
include: "rules/domain_valley_widths.smk"
include: "rules/common_regions.smk"
include: "rules/domain_chi_region.smk"
include: "rules/domain_lithology_channels.smk"
include: "rules/reporting.smk"


RUN_ID = config["run_id"]
MODULE = config["analysis"]["module"]


def _targets():
    root = config["io"]["root"]
    outs = []
    if config["stages"].get("extract", False) and MODULE == "cosmo_landslides":
        outs.extend([
            f"{root}/{RUN_ID}/extract/dem_junction_basin_outlines.fgb",
            f"{root}/{RUN_ID}/extract/dem_channel_network_lines.fgb",
            f"{root}/{RUN_ID}/extract/dem_channel_network_junctions.fgb",
        ])
    if config["stages"].get("extract", False) and MODULE == "check_basins":
        outs.extend([
            f"{root}/{RUN_ID}/extract/check_junction_basin_outlines.fgb",
            f"{root}/{RUN_ID}/extract/check_channel_network_lines.fgb",
        ])
    if config["stages"].get("analyze", False) and MODULE == "cosmo_landslides":
        outs.extend([
            f"{root}/{RUN_ID}/analysis/cosmo_landslides/ls_LS_INVENTORY.csv",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides/ls_LS_TFAIL.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides/ls_LS_EXCAVATION.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides/ls_LS_CONC.tif",
        ])
    if config["stages"].get("analyze", False) and MODULE == "cosmo_step_change_random_network":
        outs.extend([
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_Be10_step_crn_conc.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_Al26_step_crn_conc.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_C14_step_crn_conc.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_R2610_step.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_R1410_step.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_step_change/sc_SC_STEPTIME.tif",
        ])
    if MODULE == "cosmo_landslides_synthetic" and config["stages"].get("analyze", False):
        outs.extend([
            f"{root}/{RUN_ID}/preprocess/ls_synth_hillshade.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides_single/ls_single_LS_INVENTORY.csv",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides_single/ls_single_LS_TFAIL.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides_single/ls_single_LS_EXCAVATION.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides_single/ls_single_LS_CONC.tif",
            f"{root}/{RUN_ID}/analysis/cosmo_landslides_series/ls_series_LS_SAMPLE_EFFECT.csv",
        ])
    if MODULE == "cosmo_landslides_synthetic" and config["stages"].get("report", False):
        outs.extend([
            f"{root}/{RUN_ID}/reports/cosmo_landslides/ls_single_landslide_outlines.fgb",
            f"{root}/{RUN_ID}/reports/cosmo_landslides/ls_single_larsen_size_comparison.png",
            f"{root}/{RUN_ID}/reports/cosmo_landslides/ls_series_apparent_vs_true_erosion.png",
            f"{root}/{RUN_ID}/reports/cosmo_landslides/ls_series_sample_bias_ratio.png",
        ])
    if MODULE == "cosmo_transient_landslides" and config["stages"].get("analyze", False):
        # The whole ensemble is pulled in declaratively by this one target: the
        # statistics rule depends on every (magnitude, seed, scenario) join.
        reports = f"{root}/{RUN_ID}/reports/cosmo_transient_landslides"
        outs.extend([
            f"{reports}/ensemble_per_seed.csv",
            f"{reports}/ensemble_summary.csv",
            f"{reports}/ensemble_anchor_check.csv",
            f"{reports}/ensemble_report.txt",
        ])
    if MODULE == "valley_widths":
        outs.extend(valley_widths_targets())
    if MODULE == "chi_region":
        outs.extend(chi_region_targets())
    if MODULE == "lithology_channels":
        outs.extend(lithology_channels_targets())
    if config["stages"].get("report", False):
        outs.append(f"{root}/{RUN_ID}/reports/{RUN_ID}_RUN_MANIFEST.json")
    return outs


rule all:
    input:
        _targets()
